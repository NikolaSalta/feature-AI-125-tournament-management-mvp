# =====================================================
# Tournament Service Backend - Environment Variables
# =====================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =====================================================
# Database Configuration
# =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tournament_db
DB_USERNAME=tournament_user
DB_PASSWORD=your_secure_password_here

# =====================================================
# GitHub OAuth2 Configuration
# =====================================================
# Create OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:8080
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# =====================================================
# JWT Configuration (Optional - for API tokens)
# =====================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_secret_key_here
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# =====================================================
# Server Configuration
# =====================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# =====================================================
# HashiCorp Vault (Optional)
# =====================================================
VAULT_ENABLED=false
VAULT_HOST=127.0.0.1
VAULT_PORT=8200
VAULT_TOKEN=your_vault_token_here

# =====================================================
# JVM Configuration (Docker)
# =====================================================
JAVA_OPTS=-Xmx512m -Xms256m

# =====================================================
# Production Notes
# =====================================================
# - Never commit .env files to version control
# - Use strong passwords and secrets in production
# - Consider using HashiCorp Vault for secret management
# - Set SPRING_PROFILES_ACTIVE=prod for production
# - Register GitHub OAuth App for each environment
